    <entry>
      <name>POST-LOAD VALIDATION</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>SELECT 'fact_batch_production' AS fact_table,
       (SELECT COUNT(*) FROM staging.stg_mes_batch_production
        WHERE batch_id IS NOT NULL) AS staging_rows,
       (SELECT COUNT(*) FROM dw.fact_batch_production) AS target_rows

UNION ALL
SELECT 'fact_lab_test',
       (SELECT COUNT(*) FROM staging.stg_lims_lab_test_results
        WHERE test_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_lab_test)

UNION ALL
SELECT 'fact_quality_deviation',
       (SELECT COUNT(*) FROM staging.stg_qms_quality_deviations
        WHERE deviation_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_quality_deviation)

UNION ALL
SELECT 'fact_clinical_trial',
       (SELECT COUNT(*) FROM staging.stg_ctms_clinical_trials
        WHERE trial_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_clinical_trial)

UNION ALL
SELECT 'fact_inventory',
       (SELECT COUNT(*) FROM staging.stg_wms_warehouse_inventory
        WHERE inventory_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_inventory)

UNION ALL
SELECT 'fact_shipment',
       (SELECT COUNT(*) FROM staging.stg_supply_chain_shipments
        WHERE shipment_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_shipment)

UNION ALL
SELECT 'fact_regulatory_submission',
       (SELECT COUNT(*) FROM staging.stg_regulatory_submissions
        WHERE submission_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_regulatory_submission)

UNION ALL
SELECT 'fact_iot_reading',
       (SELECT COUNT(*) FROM staging.stg_iot_equipment_sensors
        WHERE reading_id IS NOT NULL),
       (SELECT COUNT(*) FROM dw.fact_iot_reading);</sql>
