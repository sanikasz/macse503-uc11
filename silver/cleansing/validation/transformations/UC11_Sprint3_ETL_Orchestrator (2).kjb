      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>T</sqlfromfile>
      <sqlfilename>C:\Users\thoma\Downloads\UC11_Load_Dimensions_and_Facts.sql</sqlfilename>
      <sendOneStatement>F</sendOneStatement>
      <connection>PostgreSQL 18</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>2</nr>
      <xloc>480</xloc>
      <yloc>112</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>POST-LOAD VALIDATION (configure SQL)</name>
      <description>Run sql/20_post_load_validation.sql and review all result sets.</description>
      <type>SQL</type>
      <attributes/>
      <sql>
WITH counts AS (
    SELECT
        'fact_batch_production' AS fact_table,
        COUNT(DISTINCT batch_id) AS source_rows
    FROM staging.stg_mes_batch_production
    WHERE batch_id IS NOT NULL
    UNION ALL
    SELECT 'fact_lab_test',
           COUNT(DISTINCT test_id)
    FROM staging.stg_lims_lab_test_results
    WHERE test_id IS NOT NULL
    UNION ALL
    SELECT 'fact_quality_deviation',
           COUNT(DISTINCT deviation_id)
    FROM staging.stg_qms_quality_deviations
    WHERE deviation_id IS NOT NULL
    UNION ALL
    SELECT 'fact_clinical_trial',
           COUNT(DISTINCT trial_id)
    FROM staging.stg_ctms_clinical_trials
    WHERE trial_id IS NOT NULL
    UNION ALL
    SELECT 'fact_inventory',
           COUNT(DISTINCT inventory_id)
    FROM staging.stg_wms_warehouse_inventory
    WHERE inventory_id IS NOT NULL
    UNION ALL
    SELECT 'fact_shipment',
           COUNT(DISTINCT shipment_id)
    FROM staging.stg_supply_chain_shipments
    WHERE shipment_id IS NOT NULL
    UNION ALL
    SELECT 'fact_regulatory_submission',
           COUNT(DISTINCT submission_id)
    FROM staging.stg_regulatory_submissions
    WHERE submission_id IS NOT NULL
    UNION ALL
    SELECT 'fact_iot_reading',
           COUNT(DISTINCT reading_id)
    FROM staging.stg_iot_equipment_sensors
    WHERE reading_id IS NOT NULL
),
targets AS (
    SELECT 'fact_batch_production' AS fact_table,
           COUNT(*) AS target_rows
    FROM dw.fact_batch_production
    UNION ALL
    SELECT 'fact_lab_test', COUNT(*) FROM dw.fact_lab_test
    UNION ALL
    SELECT 'fact_quality_deviation', COUNT(*)
    FROM dw.fact_quality_deviation
    UNION ALL
    SELECT 'fact_clinical_trial', COUNT(*)
    FROM dw.fact_clinical_trial
    UNION ALL
    SELECT 'fact_inventory', COUNT(*) FROM dw.fact_inventory
    UNION ALL
    SELECT 'fact_shipment', COUNT(*) FROM dw.fact_shipment
    UNION ALL
    SELECT 'fact_regulatory_submission', COUNT(*)
    FROM dw.fact_regulatory_submission
    UNION ALL
    SELECT 'fact_iot_reading', COUNT(*) FROM dw.fact_iot_reading
)
SELECT
    c.fact_table,
    c.source_rows AS distinct_source_ids,
    t.target_rows,
    c.source_rows - t.target_rows AS count_difference
FROM counts c
JOIN targets t USING (fact_table)
ORDER BY c.fact_table;
</sql>
