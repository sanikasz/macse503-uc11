    <entry>
      <name>PRE-FLIGHT (configure SQL)</name>
      <description>Run sql/00_preflight.sql after staging ingestion has completed.</description>
      <type>SQL</type>
      <attributes/>
      <sql>
WITH expected_tables(table_schema, table_name) AS (
    VALUES
        ('staging', 'stg_erp_product_master'),
        ('staging', 'stg_erp_supplier_master'),
        ('staging', 'stg_mes_batch_production'),
        ('staging', 'stg_lims_lab_test_results'),
        ('staging', 'stg_qms_quality_deviations'),
        ('staging', 'stg_ctms_clinical_trials'),
        ('staging', 'stg_wms_warehouse_inventory'),
        ('staging', 'stg_supply_chain_shipments'),
        ('staging', 'stg_regulatory_submissions'),
        ('staging', 'stg_iot_equipment_sensors'),
        ('dw', 'dim_product'),
        ('dw', 'dim_supplier'),
        ('dw', 'dim_plant'),
        ('dw', 'dim_warehouse'),
        ('dw', 'dim_date'),
        ('dw', 'bridge_supplier_product'),
        ('dw', 'fact_batch_production'),
        ('dw', 'fact_lab_test'),
        ('dw', 'fact_quality_deviation'),
        ('dw', 'fact_clinical_trial'),
        ('dw', 'fact_inventory'),
        ('dw', 'fact_shipment'),
        ('dw', 'fact_regulatory_submission'),
        ('dw', 'fact_iot_reading')
)
SELECT e.table_schema, e.table_name
FROM expected_tables e
LEFT JOIN information_schema.tables t
    ON t.table_schema = e.table_schema
   AND t.table_name = e.table_name
WHERE t.table_name IS NULL
ORDER BY e.table_schema, e.table_name;
</sql>
